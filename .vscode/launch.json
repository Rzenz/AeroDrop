{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AeroDrop (app)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config.json"]
    },
    {
      "name": "AeroDrop (website)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=config.json",
        "--web-port=5050"
      ]
    }
  ]
}

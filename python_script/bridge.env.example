# Copy this file to bridge.env and fill it in. bridge.env is ignored by git.

# Supabase project (Project Settings > API). The anon key is the public one
# the app already uses; never put the service_role key here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# An AeroDrop administrator account. The bridge signs in as this account to
# read the order and write the drone's telemetry.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Mission Planner: Ctrl+F > MAVLink > UDP Inbound/Outbound, port 14551,
# with "Write Access" ticked.
MAVLINK_CONN_STR=udpin:127.0.0.1:14551

# Optional overrides (defaults shown)
# FLUTTER_UDP_PORT=5005
# FLUTTER_TCP_PORT=5006
# SERVO_CHANNEL=9
# SERVO_LOW_PWM=1000
# SERVO_HIGH_PWM=2000
# DROP_DELAY_SEC=3.0
# MIN_BATTERY_PCT=40
# BASE_RADIUS_M=30
# NO_FLY_MARGIN_M=10

# The Supabase project the AeroDrop app uses: the same values the app is built
# with (--dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...).
# Both are required; the site does not run without them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The app's Google Play listing. The "Download now" and "Get it on Google Play"
# buttons are hidden until this is set.
VITE_PLAY_STORE_URL=
